# agent-dealer production configuration
# Install: cp scripts/templates/prod.env.example ~/.agent-dealer/.env

AGENT_DEALER_ENV=production

# SQLite data directory (default: ~/.agent-dealer)
# AGENT_DEALER_HOME=

# API server port (default: 2221)
PORT=2221

# Dashboard URL for Linear sync comment links
AGENT_DEALER_WEB_URL=http://localhost:2222

# Scripts / external callers (default: http://127.0.0.1:2221)
# AGENT_DEALER_API=http://127.0.0.1:2221

# Linear (optional)
# LINEAR_API_KEY=
# LINEAR_TEAM_ID=
# LINEAR_STATE_FILTER="Backlog,Todo,In Progress,In Review"

# Agent Deck (optional)
# AGENT_DECK_API_URL=http://127.0.0.1:1111

# Queue settings
# MAX_CONCURRENT_RUNS=2
# POLL_INTERVAL_MS=30000

# Claude / Cursor runners — see scripts/templates/dev.env.example for CLI notes

# Cursor Team capacity (NOT-249, optional) — official Admin API team billing,
# distinct from the local Cursor CLI login. Key stays server-side.
# CURSOR_ADMIN_API_KEY=

# Cursor Individual capacity (NOT-250, EXPERIMENTAL opt-in, off by default) —
# undocumented dashboard endpoints via the local Cursor login. Set to
# `experimental` to enable; unset to disable. Login token stays in-memory
# only (never persisted, logged, or sent to the browser).
# AGENT_DEALER_CURSOR_INDIVIDUAL_CAPACITY=experimental

# Claude account capacity (NOT-268, local-first, paid-after-1h by default) — the free
# local cache (cachedUsageUtilization in ~/.claude.json) is always read on
# the capacity poll and costs nothing. The paid fallback fires at most
# one minimal Haiku probe (--max-turns 1, no tools/MCP, ≤$0.01) per hour,
# only when every valid 5H/1W observation is older than 60 minutes. Set
# `off` to disable it; unrecognized values also fail closed.
# AGENT_DEALER_CLAUDE_CAPACITY_REFRESH=off

# Muse account capacity (local-first, paid-after-1h by default) — a free
# usage/read on the owned host always runs first. If either 5H or 1W remains
# missing/stale for one hour, one fixed minimal turn on a restricted,
# no-shell/no-write host refreshes both. Single-flight with bounded timeout
# and failure backoff. Set `off` to prohibit the paid fallback. The legacy
# AGENT_DEALER_MUSE_CAPACITY_REFRESH_MS=off remains no-spend when this is unset.
# AGENT_DEALER_MUSE_CAPACITY_REFRESH=off
# AGENT_DEALER_MUSE_CAPACITY_PROBE_TIMEOUT_MS=60000
