# agent-dealer development configuration
# Install: cp scripts/templates/dev.env.example ~/.agent-dealer-dev/.env

AGENT_DEALER_ENV=development

# SQLite data directory (default: ~/.agent-dealer-dev — same folder as this file)
# AGENT_DEALER_HOME=

# API server port (default for dev: 3221)
# PORT=3221

# Dashboard port (default for dev: 3222; Vite reads WEB_PORT)
# WEB_PORT=3222

# Linear poll (optional — manual tasks work without this)
# When set, these override saved Inbox filters until removed from env:
# LINEAR_API_KEY=
# LINEAR_TEAM_ID=
# LINEAR_STATE_FILTER="Backlog,Todo,In Progress,In Review"
# LINEAR_AUTO_ENQUEUE=0   # deprecated — promote via Inbox UI or REST

# Links in Linear sync comments (default for dev: http://localhost:3222)
# AGENT_DEALER_WEB_URL=

# Claude runner (plan + execute via `claude -p`)
# Preferred: interactive `claude login` once — uses Pro/Max plan limits, no key needed.
# Do NOT set ANTHROPIC_API_KEY if you want subscription billing (API key overrides login).
# ANTHROPIC_API_KEY=   # only for CI/headless API billing
# Server prepends ~/.local/bin to PATH at startup (Claude Code default install location).
# CLAUDE_CLI=/full/path/to/claude   # override if health still misses the binary
# CURSOR_CLI=/full/path/to/cursor-agent   # override if health still misses the binary

# Agent Deck UI for deck picker proxy (default: http://127.0.0.1:1111; MCP on :1110)
# AGENT_DECK_API_URL=http://127.0.0.1:1111

# flow:verify and scripts (default for dev: http://127.0.0.1:3221)
# AGENT_DEALER_API=http://127.0.0.1:3221

# Queue settings
# MAX_CONCURRENT_RUNS=2
# POLL_INTERVAL_MS=30000

# P0 script only — optional deck/playbook for claude -p prompts
# DECK_ID=
# PLAYBOOK_ID=
# WORKSPACE_ROOT=
# CLAUDE_MCP_CONFIG=~/.claude.json

# Cursor runner (future — `cursor agent -p --trust --output-format stream-json`)
# Requires `cursor agent login`; non-interactive subprocess needs --trust

# Cursor Team capacity (NOT-249, optional) — official Admin API
# (https://docs.cursor.com/en/account/teams/admin-api). Team-level billing
# only (cycle start/spend in cents; the API reports no team hard limit and
# no cycle end, so both stay null); distinct from the local
# `cursor agent login` CLI session. Never logged, never returned to the browser.
# CURSOR_ADMIN_API_KEY=

# Cursor Individual capacity (NOT-250, EXPERIMENTAL opt-in, off by default) —
# undocumented dashboard endpoints via the existing local Cursor login (no
# supported contract, no support guarantee, no browser automation). Set to
# `experimental` to enable; unset to disable. Monthly billing-cycle values
# only (cycle label/reset, reported usage, remaining %); the raw login token
# is used in-memory only and is never persisted, logged, or sent to the
# browser. Prefer a supported Cursor API automatically when one exists.
# AGENT_DEALER_CURSOR_INDIVIDUAL_CAPACITY=experimental

# Claude account capacity (NOT-268, local-first, off by default) — the free
# local cache (cachedUsageUtilization in ~/.claude.json) is always read on
# the capacity poll and costs nothing. The paid fallback below fires at most
# one minimal Haiku probe (--max-turns 1, no tools/MCP, ≤$0.01) per hour,
# only when every valid 5H/1W observation is older than 60 minutes. Any
# other value disables it.
# AGENT_DEALER_CLAUDE_CAPACITY_REFRESH=paid-after-1h
# AGENT_DEALER_CLAUDE_CACHE_FILE=/path/to/fixture-claude.json  # override for tests/smoke
# AGENT_DEALER_CLAUDE_PROBE_TIMEOUT_MS=90000  # upper bound for one probe spawn
