# agent-dealer production configuration
# Created by: agent-dealer setup

AGENT_DEALER_ENV=production

# SQLite data directory (default: ~/.agent-dealer)
# AGENT_DEALER_HOME=

# API + dashboard port when UI is bundled (default: 2222 — prod dashboard port)
PORT=2222
AGENT_DEALER_WEB_URL=http://localhost:2222
AGENT_DEALER_API=http://127.0.0.1:2222

# Linear (optional — manual tasks work without; edit after `agent-dealer setup`)
LINEAR_API_KEY=
LINEAR_TEAM_ID=
LINEAR_STATE_FILTER="Backlog,Todo,In Progress,In Review"

# Agent Deck UI proxy (optional)
# AGENT_DECK_API_URL=http://127.0.0.1:1111

# Queue settings — the Admission queue offers global active-issue limits 1–5.
# Each bound below defaults to 5; the effective ceiling is the lower of the
# two, and the UI never offers values above it. Lower either to cap a small host.
# MAX_COORDINATOR_CONCURRENCY=5
# MAX_CONCURRENT_RUNS=5
# POLL_INTERVAL_MS=30000
