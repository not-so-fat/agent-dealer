# agent-dealer configuration (copy to .env)

# SQLite data directory (default: ~/.agent-dealer)
# AGENT_DEALER_HOME=

# API server port (default: 8765)
# PORT=8765

# Linear poll (optional — manual tasks work without this)
# LINEAR_API_KEY=
# LINEAR_TEAM_ID=
# LINEAR_STATE_FILTER="Todo,In Progress,Backlog"
# LINEAR_AUTO_ENQUEUE=0   # deprecated — promote via Inbox UI or REST

# Links in Linear sync comments (default: http://localhost:5173)
# AGENT_DEALER_WEB_URL=

# Claude runner (plan + execute via `claude -p`)
# Preferred: interactive `claude login` once — uses Pro/Max plan limits, no key needed.
# Do NOT set ANTHROPIC_API_KEY if you want subscription billing (API key overrides login).
# ANTHROPIC_API_KEY=   # only for CI/headless API billing
# Server prepends ~/.local/bin to PATH at startup (Claude Code default install location).
# CLAUDE_CLI=/full/path/to/claude   # override if health still misses the binary
# CURSOR_CLI=/full/path/to/cursor

# Agent Deck API for deck picker proxy (default: http://127.0.0.1:11111)
# AGENT_DECK_API_URL=http://127.0.0.1:11111

# Queue settings
# MAX_CONCURRENT_RUNS=2
# POLL_INTERVAL_MS=30000

# P0 script only — optional deck/playbook for claude -p prompts
# DECK_ID=
# PLAYBOOK_ID=
# WORKSPACE_ROOT=
# CLAUDE_MCP_CONFIG=~/.claude.json

# Cursor runner (future — `cursor agent -p --trust --output-format stream-json`)
# Requires `cursor agent login`; non-interactive subprocess needs --trust
